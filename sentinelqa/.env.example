# Modèle du fichier de clés de SentinelQA. NE RIEN REMPLIR ICI : ce fichier entre dans le dépôt git.
# Chaque membre de l'équipe crée le sien hors du dépôt, dans ~/.config/sentinelqa/.env (droits 600),
# et y met ses valeurs. La clé H n'y figure pas : `holo login` la range dans ~/.config/hai/.env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SESSIONPOOL_URL=
HF_TOKEN=
