    {
      "parameters": {
        "jsCode": "const sortie = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  let corps = null;\n  if (item.binary && item.binary.data) {\n    const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n    corps = buf.toString('utf8');\n  }\n  if (!corps) {\n    corps = typeof item.json.body === 'string' ? item.json.body : JSON.stringify(item.json.body ?? {});\n  }\n  const h = item.json.headers || {};\n  sortie.push({ json: {\n    corps,\n    signature: h['x-hub-signature-256'] || null,\n    evenement: h['x-github-event'] || null,\n    livraison: h['x-github-delivery'] || null\n  } });\n}\nreturn sortie;"
      },
      "id": "366e2f59-f644-4de3-963d-219886ec6df3",
      "name": "Lire le corps et la signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        608
      ]
    },
