# Modèle de variables serveur, sans valeurs. Ne pas placer de vrais secrets dans ce dépôt.
# En local, les services partagés lisent déjà ~/.config/sentinelqa/.env et ~/.config/hai/.env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
HF_TOKEN=
HAI_API_KEY=

# Au moins 24 caractères ; requis pour accéder à la console en production.
HSENTINEL_OPERATOR_TOKEN=

# Analytics facultatifs, désactivés par défaut.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
